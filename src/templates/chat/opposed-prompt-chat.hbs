<div class="rt-wrapper">
    <div class="rt-chat">
        <div class="rt-roll">
            <h2>{{powerName}}</h2>
            <div class="rt-roll__divider"></div>
            <div class="rt-roll__row--full">
                <span>Opposed <strong>{{opposedLabel}}</strong> Test — the defender rolls to resist.</span>
            </div>
            <div class='rt-roll__controls-1'>
                <div class="rt-control-button roll-control__roll-opposed"
                     data-opposed-char="{{opposedChar}}"
                     data-opposed-label="{{opposedLabel}}"
                     data-opposed-is-skill="{{isSkill}}"
                     data-power-name="{{powerName}}"
                     data-target-uuid="{{targetUuid}}">
                    <span class="rt-control-button__span material-icons">casino</span>
                    <span class="rt-control-button__label">Roll Opposed ({{opposedLabel}})</span>
                </div>
            </div>
        </div>
    </div>
</div>
