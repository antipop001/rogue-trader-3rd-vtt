{{#with rollData}}
    <div class="rt-wrapper">
        <div class="rt-chat">
            <h3>{{sheetName}}</h3>
            <div class="rt-roll">
                <h1>{{name}}</h1>
                <h2>{{type}}</h2>
                <h2>{{lookup difficulties difficulty}}</h2>
                <div class="rt-roll__divider"></div>

                <div class="rt-roll__row rt-roll__row--number">
                    <div class="rt-roll__label">Base</div>
                    <div class="rt-roll__value">{{baseTarget}}</div>
                </div>
                {{#each activeModifiers}}
                    <div class="rt-roll__row rt-roll__row--number">
                        <div class="rt-roll__label">Modifier: {{@key}}</div>
                        <div class="rt-roll__value">{{this}}</div>
                    </div>
                {{/each}}
                <div class="rt-roll__target">
                    <div class="rt-roll__label">Target</div>
                    <div class="rt-roll__value">{{modifiedTarget}}</div>
                </div>
                {{#if voidshipTurrets}}
                    {{#if success}}
                        <div class="rt-roll__success">
                            <span>Amount of Hits:</span>
                            <span>{{turretsHit}}</span>
                        </div>
                        <div class="rt-roll__row rt-roll__row--number">
                            <div class="rt-roll__label">Rolls:</div>
                            <div class="rt-roll__value">
                                {{#each voidshipResults}}
                                    {{#unless @first}}, {{/unless}}{{this}}
                                {{/each}}
                            </div>
                        </div>
                    {{else}}
                        <div class="rt-roll__fail">
                            <span>All Turrets Missed</span>
                        </div>
                        <div class="rt-roll__row rt-roll__row--number">
                            <div class="rt-roll__label">Rolls:</div>
                            <div class="rt-roll__value">
                                {{#each voidshipResults}}
                                    {{#unless @first}}, {{/unless}}{{this}}
                                {{/each}}
                            </div>
                        </div>
                    {{/if}}
                {{else}}
                    {{#if voidshipBoarding}}
                        {{#if success}}
                            <div class="rt-roll__success">
                                <span>Successful Actions:</span>
                                <span>{{boardingSuccess}}</span>
                            </div>
                            <div class="rt-roll__row rt-roll__row--number">
                                <div class="rt-roll__label">Damage:</div>
                                <div class="rt-roll__value">{{boardingDamage}}</div>
                            </div>
                            <div class="rt-roll__row rt-roll__row--number">
                                <div class="rt-roll__label">Rolls:</div>
                                <div class="rt-roll__value">
                                    {{#each voidshipResults}}
                                        {{#unless @first}}, {{/unless}}{{this}}
                                    {{/each}}
                                </div>
                            </div>
                        {{else}}
                            <div class="rt-roll__fail">
                                <span>All Actions Failed</span>
                            </div>
                            <div class="rt-roll__row rt-roll__row--number">
                                <div class="rt-roll__label">Rolls:</div>
                                <div class="rt-roll__value">
                                    {{#each voidshipResults}}
                                        {{#unless @first}}, {{/unless}}{{this}}
                                    {{/each}}
                                </div>
                            </div>
                        {{/if}}
                    {{else}}
                        {{#if voidshipFlawless}}
                            <div class="rt-roll__flawless">
                                <span>Flawless</span>
                                <span>{{roll.total}}</span>
                            </div>
                        {{else}}
                            {{#if voidshipSuccess}}
                                <div class="rt-roll__success">
                                    <span>Success</span>
                                    <span>{{roll.total}}</span>
                                </div>
                            {{else}}
                                {{#if voidshipFlawedSuccess}}
                                    <div class="rt-roll__flawed">
                                        <span>Flawed Success</span>
                                        <span>{{roll.total}}</span>
                                    </div>
                                {{else}}
                                    {{#if voidshipFailure}}
                                        <div class="rt-roll__fail">
                                            <span>Failure</span>
                                            <span>{{roll.total}}</span>
                                        </div>
                                    {{else}}
                                        {{#if voidshipFumble}}
                                            <div class="rt-roll__fumble">
                                                <span>FUMBLE!</span>
                                                <span>{{roll.total}}</span>
                                            </div>
                                        {{else}}
                                            {{#if success}}
                                                <div class="rt-roll__success">
                                                    <span>Success</span>
                                                    <span>{{roll.total}}</span>
                                                </div>
                                                <div class="rt-roll__row rt-roll__row--number">
                                                    <div class="rt-roll__label">Degrees of Success</div>
                                                    <div class="rt-roll__value">{{dos}}</div>
                                                </div>
                                            {{else}}
                                                <div class="rt-roll__fail">
                                                    <span>Fail</span>
                                                    <span>{{roll.total}}</span>
                                                </div>
                                                <div class="rt-roll__row rt-roll__row--number">
                                                    <div class="rt-roll__label">Degrees of Failure</div>
                                                    <div class="rt-roll__value">{{dof}}</div>
                                                </div>
                                            {{/if}}
                                        {{/if}}
                                    {{/if}}
                                {{/if}}
                            {{/if}}
                        {{/if}}
                    {{/if}}
                {{/if}}
            </div>
            {{#if actor.system.fate}}
                <div class="rt-roll__controls-1">
                    <div class="rt-control-button roll-control__spend-fate" data-actor-uuid="{{actor.uuid}}"
                         data-tooltip="Spend a Fate Point (re-roll / +10 / +1 Degree) — subtracts 1 from current Fate">
                        <span class="rt-control-button__span material-icons">auto_awesome</span>
                        <span class="rt-control-button__label">Spend Fate</span>
                    </div>
                </div>
            {{/if}}
            <div class="dice-rolls" style="display:none">
                <div class="dice-roll-render">
                    {{{render}}}
                </div>
            </div>
        </div>
    </div>
{{/with}}
