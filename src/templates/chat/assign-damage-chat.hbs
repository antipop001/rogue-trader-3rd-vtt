<div class="rt-wrapper">
    <div class="rt-chat">
        <div class="rt-roll">
            {{#if this.hit.voidshipHit}}
                <h1>{{this.actor.name}}</h1>
                <h2>{{this.hit.voidshipHitLocation}} Hit</h2>
                <div class="rt-roll__divider"></div>

                <div class="rt-roll__row rt-roll__row--number">
                    <div class="rt-roll__label">Hull</div>
                    <div class="rt-roll__value">{{this.actor.system.hull.value}}
                        / {{this.actor.system.hull.max}}</div>
                </div>

                <div class="rt-roll__fail">
                    <span>{{this.voidshipHullDamage}}</span>
                    <span>Hull Damage</span>
                </div>
                <div class="rt-roll__label">{{this.criticalEffect}}</div>
            {{else}}
                <h1>{{this.actor.name}}</h1>
                {{#if hasDamage}}<h2>{{this.hit.location}} Hit</h2>{{/if}}
                {{#if this.coverApplied}}
                    <div class="rt-roll__label">Cover (AP {{this.coverAp}}) absorbed {{this.coverAbsorbed}}{{#if this.coverDegraded}} — cover AP reduced to {{this.coverApAfter}}{{/if}}</div>
                {{/if}}
                <div class="rt-roll__divider"></div>

                <div class="rt-roll__row rt-roll__row--number">
                    <div class="rt-roll__label">Wounds</div>
                    <div class="rt-roll__value">{{this.actor.system.wounds.value}}
                        / {{this.actor.system.wounds.max}}</div>
                </div>
                <div class="rt-roll__row rt-roll__row--number">
                    <div class="rt-roll__label">Fatigue</div>
                    <div class="rt-roll__value">{{this.actor.system.fatigue.value}}
                        / {{this.actor.system.fatigue.max}}</div>
                </div>
                <div class="rt-roll__row rt-roll__row--number">
                    <div class="rt-roll__label">Critical Wounds</div>
                    <div class="rt-roll__value">{{this.actor.system.wounds.critical}}</div>
                </div>

                {{#if this.hasDamage}}
                    <div class="rt-roll__fail">
                        <span>{{this.damageTaken}}</span>
                        <span>{{this.hit.damageType}} Damage</span>
                    </div>
                {{/if}}
                {{#if this.hasFatigueDamage}}
                    <div class="rt-roll__fail">
                        <span>{{this.fatigueTaken}}</span>
                        <span>Fatigue</span>
                    </div>
                {{/if}}
                {{#if this.hasCriticalDamage}}
                    <div class="rt-roll__fail">
                        <span>{{this.criticalDamageTaken}}</span>
                        <span>Critical Damage</span>
                    </div>
                    <div class="rt-roll__label">{{this.criticalEffect}}</div>
                {{/if}}
            {{/if}}
        </div>
    </div>
</div>
