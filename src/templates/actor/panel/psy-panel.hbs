<div class="rt-panel rt-grid-col-2 rt-grid-row-1">
    <h1 class="rt-panel__header">Psyker</h1>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Psy Rating</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.psy.rating" value="{{actor.psy.rating}}" />
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Sustained Rating</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.psy.sustained" value="{{actor.psy.sustained}}" />
    </div>
    <div class="rt-field__wrapper">
        <div class="rt-field__header">Has Focus</div>
        <span class="rt-field__input check">
            <input {{checked actor.psy.hasFocus}} data-dtype="Boolean" type="checkbox" name="system.psy.hasFocus" />
        </span>
    </div>
    <div class="rt-field__wrapper">
        <div class="rt-field__header">Class</div>
        <select class="rt-field__input" name="system.psy.class">
            {{option "sanctioned" actor.psy.class "Sanctioned"}}
            {{option "unsanctioned" actor.psy.class "Unsanctioned"}}
            {{option "bound" actor.psy.class "Bound (legacy)"}}
            {{option "unbound" actor.psy.class "Unbound (legacy)"}}
        </select>
    </div>
    <div class="rt-field__wrapper">
        <div class="rt-field__header">Default Strength</div>
        <select class="rt-field__input" name="system.psy.strength">
            {{option "fettered" actor.psy.strength "Fettered"}}
            {{option "unfettered" actor.psy.strength "Unfettered"}}
            {{option "push" actor.psy.strength "Push"}}
        </select>
    </div>
</div>