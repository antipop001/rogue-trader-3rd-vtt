<div class="rt-panel spacer rt-grid-col-2 rt-grid-row-1 rt-vital {{vitalTint actor.wounds.value actor.wounds.max}}">
    <h1 class="rt-panel__header">Wounds</h1>
    <div class="rt-field__wrapper">
        <span class="rt-field__header" data-tooltip="Rolled/starting Wounds (RT Core p.30). Talent bonuses like Sound Constitution are added automatically into Max.">Base</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.wounds.base" value="{{actor.system.wounds.base}}" />
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header" data-tooltip="Calculated: Base + talent/effect bonuses (e.g. Sound Constitution +1 each).">Max</span>
        <span class="rt-field__span">{{actor.wounds.max}}</span>
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Current</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.wounds.value" value="{{actor.wounds.value}}" />
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Critical</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.wounds.critical" value="{{actor.wounds.critical}}" />
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">State</span>
        <span class="rt-field__span">{{defaultVal actor.system.wounds.state 'Healthy'}}</span>
    </div>
    <div class="rt-field__wrapper">
        <label class="rt-control-button" data-action="restDay" data-tooltip="Natural healing — a day's bed rest (RT Core p.262)">Rest (Day)</label>
        <label class="rt-control-button" data-action="restWeek" data-tooltip="Natural healing — a week's complete rest (RT Core p.262)">Rest (Week)</label>
    </div>
    <div class="rt-table--border rt-criticalinjurytable--border">
        <div class="table-row--head">
            <div class="table-cell--span2">Critical Injuries</div>
            <div class="table-cell--last">
                <label class="rt-control-button item-create" data-action="itemCreate" data-type="criticalInjury">
                    <span class="rt-control-button__span material-icons">{{defaultVal icon 'add_circle'}}</span>
                </label>
            </div>
        </div>
        {{#each items as | item |}}
            {{#if item.isCriticalInjury}}
                <div class="table-row">
                    <div class="table-cell--settingstoggle">
                        <label class="rt-control-button item-edit" data-action="itemEdit" data-item-id="{{item.id}}">
                            <span class="rt-control-button__span material-icons">{{defaultVal icon 'settings'}}</span>
                        </label>
                    </div>
                    <div class="table-cell">
                        {{> systems/rogue-trader-3rd/templates/actor/partial/trait-toggle.hbs toggle=(concat 'description_' item.id) text=item.name}}
                    </div>
                    <div class="table-cell">
                        <label class="rt-control-button item-delete" data-action="itemDelete" data-item-id="{{item.id}}">
                            <span class="rt-control-button__span material-icons">{{defaultVal icon 'delete'}}</span>
                        </label>
                    </div>
                    <div class="table-cell--description description_{{item.id}}" {{hideIfNot
                        (isExpanded (concat 'description_' item.id ))}}>
                        <span>{{item.system.description}}</span>
                    </div>
                </div>
            {{/if}}
        {{/each}}
    </div>
</div>
