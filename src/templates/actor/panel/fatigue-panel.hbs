<div class="rt-panel spacer rt-grid-col-2 rt-grid-row-1">
    <h1 class="rt-panel__header">Fatigue</h1>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Max</span>
        <span class="rt-field__span">{{actor.fatigue.max}}</span>
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Current</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.fatigue.value" value="{{actor.fatigue.value}}" />
    </div>
    {{#if actor.fatigue.unconscious}}
        <div class="rt-field__wrapper">
            <span class="rt-field__span" style="color: var(--rt-color-danger, #b04040); font-weight: bold;">Unconscious</span>
        </div>
    {{else}}
        {{#if actor.fatigue.fatigued}}
            <div class="rt-field__wrapper">
                <span class="rt-field__span" style="color: var(--rt-color-danger, #b04040);">Fatigued (&minus;10 to all Tests)</span>
            </div>
        {{/if}}
    {{/if}}
</div>
