<div class="rt-panel spacer rt-grid-col-2">
    <h1 class="rt-panel__header"><button type="roll-header" class='combat-control' data-action='movement'>Movement</button></h1>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Speed</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.speed" value="{{actor.system.speed}}" />
        {{#if actor.system.componentBonuses.speed}}<span class="rt-field__bonus">(+{{actor.system.componentBonuses.speed}})</span>{{/if}}
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Turn Radius</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.turnRadius" value="{{actor.system.turnRadius}}" />
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Maneuverability</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.maneuverability" value="{{actor.system.maneuverability}}" />
        {{#if actor.system.componentBonuses.maneuverability}}<span class="rt-field__bonus">(+{{actor.system.componentBonuses.maneuverability}})</span>{{/if}}
    </div>
    <div class="rt-field__wrapper">
        <span class="rt-field__header">Helm Operator</span>
        <input type="number" data-dtype="Number" class="rt-field__input" name="system.operator.helm" value="{{actor.system.operator.helm}}" />
    </div>
</div>
